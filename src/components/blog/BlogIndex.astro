---
import PostCard from "./PostCard.astro";
import { postsPorIdioma } from "../../lib/blog";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const posts = await postsPorIdioma(lang);
---

<section
  aria-labelledby="blog-titulo"
  class="mx-auto max-w-sitio px-6 pb-[var(--kraken-seccion-y)] pt-16 sm:pt-24"
>
  <header class="mb-12" data-revelar>
    <p class="font-mono text-sm text-cian">
      <span class="text-neon">$</span>
      {t("blog.eyebrow")}
    </p>
    <h1 id="blog-titulo" class="mt-3 font-display text-4xl font-bold text-perla sm:text-5xl">
      {t("blog.title")}
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-bruma">{t("blog.subtitle")}</p>
  </header>

  {
    posts.length === 0 ? (
      <p class="text-bruma">{t("blog.empty")}</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p, i) => (
          <PostCard post={p} lang={lang} indice={i} />
        ))}
      </ul>
    )
  }
</section>