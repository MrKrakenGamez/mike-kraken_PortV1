---
import { slugDe, minutosLectura, formatearFecha, type Entrada } from "../../lib/blog";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  post: Entrada;
  lang: Lang;
  indice: number;
}

const { post, lang, indice } = Astro.props;
const t = useTranslations(lang);
const { data } = post;
---

<li data-revelar data-retraso={Math.min(indice, 4) * 70} class="flex">
  <a
    href={`/${lang}/blog/${slugDe(post.id)}/`}
    data-tilt
    class="group relative flex w-full flex-col rounded-md border border-bruma/20 bg-abismo/50 p-6 backdrop-blur transition hover:border-cian/60"
  >
    <p class="font-mono text-xs text-cian">
      <time datetime={data.pubDate.toISOString()}>{formatearFecha(data.pubDate, lang)}</time>
      · {minutosLectura(post.body)}
      {t("blog.minRead")}
      {
        data.draft && (
          <span class="ml-2 rounded-full border border-bruma/40 px-2 py-0.5 text-[0.65rem] uppercase tracking-wider text-bruma">
            {t("blog.draft")}
          </span>
        )
      }
    </p>

    <h3 class="mt-3 font-display text-2xl font-bold text-perla">{data.title}</h3>
    <p class="mt-3 leading-relaxed text-bruma">{data.description}</p>

    {
      data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li class="rounded-full border border-neon/40 bg-neon/10 px-3 py-1 font-mono text-xs text-perla">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <span class="mt-6 inline-flex items-center gap-2 font-display font-medium text-cian">
      {t("blog.readMore")}
      <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
    </span>
  </a>
</li>