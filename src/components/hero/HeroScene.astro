---
// Escena estática del Hero (SVG). En la Sección 4 el 3D se montará encima en equipos
// capaces y esta versión quedará como fallback.
// viewBox 1440x800. Composición cargada a la derecha para que el texto viva a la izquierda.

// Generador pseudoaleatorio con semilla: las estrellas son idénticas en cada build
let semilla = 7;
const aleatorio = () => {
  semilla = (semilla * 16807) % 2147483647;
  return (semilla - 1) / 2147483646;
};
const r1 = (n: number) => Math.round(n * 10) / 10;

const estrellas = Array.from({ length: 90 }, (_, i) => ({
  x: r1(aleatorio() * 1440),
  y: r1(aleatorio() * 470),
  r: r1(0.5 + aleatorio() * 1.3),
  o: r1(0.35 + aleatorio() * 0.65),
  titila: i % 3 === 0, // solo 1 de cada 3 parpadea
  retraso: r1(aleatorio() * 5),
}));

// Genera una franja de olas (curva suave repetida) que se extiende más allá del viewBox
function ola(y: number, amplitud: number, largo: number) {
  let d = `M-200 ${y}`;
  for (let x = -200; x < 1640; x += largo) {
    d += ` q${largo / 4} ${-amplitud} ${largo / 2} 0 t${largo / 2} 0`;
  }
  return `${d} V800 H-200 Z`;
}

// Reflejo de la luna sobre el agua
const reflejo = Array.from({ length: 7 }, (_, i) => ({
  y: 556 + i * 20,
  ancho: 90 - i * 10,
  o: r1(0.5 - i * 0.06),
}));

// Tentáculos del kraken: trazo central; se dibujan con borde, cuerpo y ventosas
const tentaculos = [
  { d: "M1260 680 C1265 590 1225 520 1200 450 S1170 340 1215 322 S1262 365 1238 382", ancho: 26 },
  { d: "M1370 690 C1370 600 1400 540 1388 470 S1350 400 1380 372 S1425 395 1408 418", ancho: 22 },
  { d: "M1315 690 C1315 640 1290 600 1300 560 S1325 520 1312 500", ancho: 16 },
];
---

<svg
  viewBox="0 0 1440 800"
  preserveAspectRatio="xMaxYMax slice"
  class="h-full w-full"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <!-- Cielo: abismo arriba, violeta tenue en el horizonte -->
    <linearGradient id="cielo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--kraken-abismo)"></stop>
      <stop offset="0.55" style="stop-color: var(--kraken-marino)"></stop>
      <stop
        offset="1"
        style="stop-color: color-mix(in srgb, var(--kraken-violeta) 40%, var(--kraken-marino))"
      ></stop>
    </linearGradient>
    <!-- Mar: del horizonte violáceo al fondo abisal -->
    <linearGradient id="mar" x1="0" y1="0" x2="0" y2="1">
      <stop
        offset="0"
        style="stop-color: color-mix(in srgb, var(--kraken-violeta) 22%, var(--kraken-marino))"
      ></stop>
      <stop offset="1" style="stop-color: var(--kraken-abismo)"></stop>
    </linearGradient>
    <radialGradient id="halo-luna">
      <stop offset="0" style="stop-color: var(--kraken-perla); stop-opacity: 0.35"></stop>
      <stop offset="0.6" style="stop-color: var(--kraken-cian); stop-opacity: 0.08"></stop>
      <stop offset="1" style="stop-color: var(--kraken-cian); stop-opacity: 0"></stop>
    </radialGradient>
    <radialGradient id="resplandor">
      <stop offset="0" style="stop-color: var(--kraken-violeta); stop-opacity: 0.5"></stop>
      <stop offset="1" style="stop-color: var(--kraken-violeta); stop-opacity: 0"></stop>
    </radialGradient>
  </defs>

  <!-- Cielo -->
  <rect width="1440" height="541" fill="url(#cielo)"></rect>

  <!-- Estrellas -->
  {
    estrellas.map((e) => (
      <circle
        cx={e.x}
        cy={e.y}
        r={e.r}
        opacity={e.o}
        class:list={["fill-perla", { titila: e.titila }]}
        style={`--o:${e.o};--retraso:${e.retraso}s`}
      />
    ))
  }

  <!-- Luna con halo y cráteres -->
  <circle cx="1290" cy="160" r="210" fill="url(#halo-luna)"></circle>
  <circle cx="1290" cy="160" r="58" class="fill-perla"></circle>
  <circle cx="1272" cy="146" r="9" class="fill-bruma" opacity="0.28"></circle>
  <circle cx="1304" cy="176" r="12" class="fill-bruma" opacity="0.22"></circle>
  <circle cx="1296" cy="138" r="5" class="fill-bruma" opacity="0.25"></circle>

  <!-- Resplandor del horizonte -->
  <ellipse cx="900" cy="540" rx="900" ry="90" fill="url(#resplandor)"></ellipse>

  <!-- Mar base -->
  <rect y="540" width="1440" height="260" fill="url(#mar)"></rect>

  <!-- Reflejo de la luna -->
  {
    reflejo.map((r) => (
      <rect
        x={1290 - r.ancho / 2}
        y={r.y}
        width={r.ancho}
        height="2.5"
        rx="1.25"
        opacity={r.o}
        class="fill-perla"
      />
    ))
  }

  <!-- Barco solitario (grupo exterior = posición; interior = animación de vaivén) -->
  <g transform="translate(1100 540) scale(1.15)">
    <g class="barco">
      <circle cx="-46" cy="-16" r="10" class="fill-cian" opacity="0.2"></circle>
      <path d="M-52 -12 Q0 -2 58 -16 L42 8 L-38 8 Z" class="fill-abismo"></path>
      <path
        d="M2 -12 V-84 M-26 -10 V-62"
        class="stroke-abismo"
        stroke-width="2.5"
        fill="none"
      ></path>
      <path d="M5 -80 Q34 -50 5 -20 Z" class="fill-abismo"></path>
      <path d="M-1 -80 Q-18 -50 -1 -20 Z" class="fill-abismo"></path>
      <path d="M-23 -58 Q-6 -40 -23 -20 Z" class="fill-abismo"></path>
      <circle cx="-46" cy="-16" r="2.5" class="fill-cian"></circle>
    </g>
  </g>

  <!-- Tentáculos del kraken: borde luminoso + cuerpo abisal + ventosas -->
  {
    tentaculos.map((t) => (
      <g fill="none" stroke-linecap="round">
        <path d={t.d} stroke-width={t.ancho + 4} class="stroke-cian/35" />
        <path d={t.d} stroke-width={t.ancho} class="stroke-abismo" />
        <path
          d={t.d}
          stroke-width={t.ancho * 0.22}
          stroke-dasharray="0.1 14"
          class="stroke-neon/70"
        />
      </g>
    ))
  }

  <!-- Olas frontales: cubren la base de los tentáculos (emergen del agua) -->
  <path d={ola(600, 10, 160)} class="fill-marino ola-a" opacity="0.92"></path>
  <path d={ola(650, 12, 200)} class="fill-abismo ola-b" opacity="0.85"></path>
  <path d={ola(710, 14, 240)} class="fill-abismo ola-a"></path>
</svg>

<style>
  /* Parpadeo suave de algunas estrellas */
  @keyframes titilar {
    0%,
    100% {
      opacity: var(--o);
    }
    50% {
      opacity: 0.15;
    }
  }
  .titila {
    animation: titilar 4.5s ease-in-out infinite;
    animation-delay: var(--retraso);
  }

  /* Vaivén del barco */
  @keyframes oleaje {
    0%,
    100% {
      transform: translateY(0) rotate(-0.6deg);
    }
    50% {
      transform: translateY(-3px) rotate(0.6deg);
    }
  }
  .barco {
    animation: oleaje 7s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  /* Deriva lenta de las olas */
  @keyframes deriva {
    from {
      transform: translateX(-24px);
    }
    to {
      transform: translateX(24px);
    }
  }
  .ola-a {
    animation: deriva 11s ease-in-out infinite alternate;
  }
  .ola-b {
    animation: deriva 8s ease-in-out infinite alternate-reverse;
  }
</style>