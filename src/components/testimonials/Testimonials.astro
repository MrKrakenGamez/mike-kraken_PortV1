---
import { testimoniosPublicados } from "../../lib/testimonios";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = await testimoniosPublicados();

const iniciales = (nombre: string) =>
  nombre
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase())
    .join("");
---

{
  items.length > 0 && (
    <section
      id="testimonials"
      aria-labelledby="testimonials-titulo"
      class="mx-auto max-w-sitio px-6 py-[var(--kraken-seccion-y)]"
    >
      <header class="mb-12" data-revelar>
        <p class="font-mono text-sm text-cian">
          <span class="text-neon">$</span>
          {t("testi.eyebrow")}
        </p>
        <h2
          id="testimonials-titulo"
          class="mt-3 font-display text-4xl font-bold text-perla sm:text-5xl"
        >
          {t("testi.title")}
        </h2>
        <p class="mt-3 max-w-2xl text-lg text-bruma">{t("testi.subtitle")}</p>
      </header>

      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {items.map(({ data }, i) => {
          // Cita en el idioma de la página; si no existe, se usa la otra (marcada con su lang)
          const propia = lang === "es" ? data.cita_es : data.cita_en;
          const cita = propia ?? data.cita_es ?? data.cita_en ?? "";
          const idiomaCita = propia ? lang : lang === "es" ? "en" : "es";

          return (
            <li data-revelar data-retraso={Math.min(i, 4) * 70} class="flex">
              <figure
                data-tilt
                class="relative flex w-full flex-col rounded-md border border-bruma/20 bg-abismo/50 p-6 backdrop-blur"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="h-8 w-8 text-neon"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M7.2 6C4.9 7.3 3.5 9.6 3.5 12.5V18h6v-6H6.3c.1-1.6.9-2.8 2.4-3.6L7.2 6zm9 0c-2.3 1.3-3.7 3.6-3.7 6.5V18h6v-6h-3.2c.1-1.6.9-2.8 2.4-3.6L16.2 6z" />
                </svg>

                <blockquote
                  class="mt-4 flex-1 leading-relaxed text-perla"
                  lang={idiomaCita !== lang ? idiomaCita : undefined}
                >
                  {cita}
                </blockquote>

                <figcaption class="mt-6 flex items-center gap-3">
                  {data.foto ? (
                    <img
                      src={data.foto}
                      alt=""
                      class="h-12 w-12 rounded-full object-cover"
                    />
                  ) : (
                    <span
                      aria-hidden="true"
                      class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-cian/40 bg-cian/10 font-display font-bold text-cian"
                    >
                      {iniciales(data.nombre)}
                    </span>
                  )}
                  <div>
                    <p class="font-display font-bold text-perla">
                      {data.enlace ? (
                        <a
                          href={data.enlace}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="transition hover:text-cian"
                        >
                          {data.nombre}
                        </a>
                      ) : (
                        data.nombre
                      )}
                    </p>
                    <p class="text-sm text-bruma">
                      {data.cargo}
                      {data.organizacion && ` · ${data.organizacion}`}
                    </p>
                    {data.draft && (
                      <span class="mt-1 inline-block rounded-full border border-bruma/40 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-bruma">
                        {t("testi.draft")}
                      </span>
                    )}
                  </div>
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </section>
  )
}