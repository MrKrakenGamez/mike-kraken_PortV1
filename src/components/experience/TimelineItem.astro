---
import type { Experiencia } from "../../data/experience";

interface Props {
  item: Experiencia;
  indice: number;
  etiquetaActual: string;
}

const { item, indice, etiquetaActual } = Astro.props;

// En escritorio, los elementos pares van a la izquierda de la línea y los impares a la derecha
const izquierda = indice % 2 === 0;
---

<li
  data-revelar
  data-retraso={Math.min(indice, 2) * 80}
  class:list={[
    "relative pb-12 pl-12 last:pb-0 md:w-1/2",
    izquierda ? "md:pl-0 md:pr-12" : "md:ml-auto md:pl-12",
  ]}
>
  <!-- Nodo sobre la línea (los colores viven en global.css: .nodo-linea) -->
  <span
    data-nodo
    aria-hidden="true"
    class:list={[
      "nodo-linea absolute left-4 top-7 h-4 w-4 -translate-x-1/2 rounded-full border-2",
      izquierda
        ? "md:left-auto md:right-0 md:translate-x-1/2"
        : "md:left-0 md:-translate-x-1/2",
    ]}
  >
    {item.actual && <span class="absolute inset-0 animate-ping rounded-full bg-cian/50" />}
  </span>

  <article
    class="rounded-md border border-bruma/20 bg-abismo/50 p-6 backdrop-blur transition hover:border-cian/40 hover:shadow-glow-cian"
  >
    <header class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <p class="font-mono text-xs text-cian">{item.periodo}</p>
      {
        item.actual && (
          <span class="rounded-full border border-cian/50 bg-cian/10 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-cian">
            {etiquetaActual}
          </span>
        )
      }
    </header>

    <h3 class="mt-2 font-display text-2xl font-bold text-perla">{item.empresa}</h3>
    <p class="font-display text-base text-neon">{item.puesto}</p>

    <p class="mt-3 leading-relaxed text-bruma">{item.descripcion}</p>

    {
      item.puntos && item.puntos.length > 0 && (
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-bruma">
          {item.puntos.map((p) => (
            <li class="flex gap-2">
              <span class="select-none text-cian" aria-hidden="true">
                ›
              </span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      )
    }

    <ul class="mt-4 flex flex-wrap gap-2">
      {
        item.etiquetas.map((e) => (
          <li class="rounded-full border border-neon/40 bg-neon/10 px-3 py-1 font-mono text-xs text-perla">
            {e}
          </li>
        ))
      }
    </ul>
  </article>
</li>