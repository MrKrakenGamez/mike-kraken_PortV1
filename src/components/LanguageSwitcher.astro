---
import { languages, type Lang } from "../i18n/ui";
import { switchLangPath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
  // Ruta equivalente por idioma, cuando no basta con cambiar el prefijo (p. ej. un artículo sin traducción)
  alternate?: Partial<Record<Lang, string>>;
}

const { lang, alternate } = Astro.props;
const t = useTranslations(lang);

const items = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  href: alternate?.[code] ?? switchLangPath(Astro.url.pathname, code),
  active: code === lang,
}));
---

<div
  role="group"
  aria-label={t("lang.label")}
  class="flex items-center gap-1 rounded-full border border-bruma/30 bg-abismo/50 p-1 font-mono text-xs"
>
  {
    items.map(({ code, href, active }) => (
      <a
        href={href}
        hreflang={code}
        lang={code}
        title={languages[code]}
        aria-current={active ? "true" : undefined}
        class:list={[
          "rounded-full px-3 py-1 uppercase transition",
          active
            ? "bg-violeta text-perla shadow-glow-violeta"
            : "text-bruma hover:text-cian",
        ]}
      >
        {code}
      </a>
    ))
  }
</div>