---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Los ids son neutros (iguales en ES y EN) y apuntan a secciones de la home
const links = [
  { id: "about", label: t("nav.about") },
  { id: "experience", label: t("nav.experience") },
  { id: "projects", label: t("nav.projects") },
  { id: "demo", label: t("nav.demo") },
  { id: "contact", label: t("nav.contact") },
].map((l) => ({ ...l, href: `/${lang}/#${l.id}` }));
---

<header
  class="sticky top-0 z-50 border-b border-bruma/15 bg-marino/70 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-sitio items-center justify-between gap-4 px-6">
    <!-- Logo provisional (se reemplazará por el kraken definitivo) -->
    <a
      href={`/${lang}/`}
      aria-label={t("nav.home")}
      class="flex items-center gap-2 font-display text-lg font-bold text-perla"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-6 w-6 text-cian"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path
          d="M12 3a7 7 0 0 0-7 7c0 2.2 1 3.6 2 4.8.8 1 .5 2.2-.5 3.2M12 3a7 7 0 0 1 7 7c0 2.2-1 3.6-2 4.8-.8 1-.5 2.2.5 3.2M9.5 14.5c.3 2-.2 3.7-1.5 5M14.5 14.5c-.3 2 .2 3.7 1.5 5M12 14.5v5.5"
        ></path>
      </svg>
      <span>Mike<span class="text-cian">Kraken</span></span>
    </a>

    <!-- Navegación de escritorio -->
    <nav aria-label={t("nav.main")} class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-bruma transition hover:text-cian">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Selector de idioma + botón hamburguesa (móvil) -->
    <div class="flex items-center gap-3">
      <LanguageSwitcher lang={lang} />
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t("nav.menuOpen")}
        data-label-open={t("nav.menuOpen")}
        data-label-close={t("nav.menuClose")}
        class="group inline-flex h-10 w-10 items-center justify-center rounded-md border border-bruma/30 text-perla transition hover:text-cian md:hidden"
      >
        <!-- Ícono hamburguesa / ícono cerrar según aria-expanded -->
        <svg viewBox="0 0 24 24" class="h-5 w-5 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg viewBox="0 0 24 24" class="hidden h-5 w-5 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Panel del menú móvil -->
  <nav
    id="mobile-menu"
    hidden
    aria-label={t("nav.main")}
    class="border-t border-bruma/15 bg-abismo/95 md:hidden"
  >
    <ul class="flex flex-col px-6 py-4">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block py-3 font-display text-lg text-perla transition hover:text-cian"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Menú móvil: abre/cierra, actualiza aria-expanded y cierra con Esc o al elegir un enlace
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu");

  if (toggle && menu) {
    const labelOpen = toggle.dataset.labelOpen ?? "";
    const labelClose = toggle.dataset.labelClose ?? "";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? labelClose : labelOpen);
      menu.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>