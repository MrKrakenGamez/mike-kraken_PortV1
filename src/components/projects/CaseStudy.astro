---
import type { CasoDeEstudio } from "../../data/projects";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  caso: CasoDeEstudio;
}

const { caso } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Problema → Rol → Decisión → Resultado
const secciones = [
  { n: "01", titulo: t("case.problem"), textos: caso.problema },
  { n: "02", titulo: t("case.role"), textos: caso.rol },
  { n: "03", titulo: t("case.decision"), textos: caso.decision },
  { n: "04", titulo: t("case.result"), textos: caso.resultado },
];
---

<article class="mx-auto max-w-4xl px-6 pb-[var(--kraken-seccion-y)] pt-16 sm:pt-24">
  <a
    href={`/${lang}/#projects`}
    class="inline-flex items-center gap-2 font-mono text-sm text-bruma transition hover:text-cian"
  >
    <span aria-hidden="true">←</span>
    {t("proj.back")}
  </a>

  <header class="mt-10" data-revelar>
    <p class="font-mono text-sm text-cian">
      <span class="text-neon">$</span>
      {t("proj.tag.caso")} · {caso.cliente}
    </p>
    <h1
      class="mt-3 bg-linear-to-r from-cian to-neon bg-clip-text font-display text-4xl font-bold leading-tight text-transparent sm:text-6xl"
    >
      {caso.titulo}
    </h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-bruma">{caso.resumen}</p>

    <!-- Diagrama de la migración: origen → destino -->
    <div
      role="img"
      aria-label={`${caso.de} → ${caso.a}`}
      class="mt-8 flex items-center gap-4"
    >
      <div
        class="rounded-md border border-bruma/30 bg-abismo/60 px-5 py-3 font-mono text-lg text-bruma"
      >
        {caso.de}
      </div>
      <svg viewBox="0 0 80 12" class="w-16 text-cian sm:w-24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line class="flujo" x1="0" y1="6" x2="68" y2="6" stroke-dasharray="6 6"></line>
        <path d="M68 1 L78 6 L68 11"></path>
      </svg>
      <div
        class="rounded-md border border-cian/50 bg-cian/10 px-5 py-3 font-mono text-lg text-cian shadow-glow-cian"
      >
        {caso.a}
      </div>
    </div>
  </header>

  <div class="mt-14 grid gap-6 md:grid-cols-2">
    {
      secciones.map((s, i) => (
        <section
          data-revelar
          data-retraso={i * 80}
          class="rounded-md border border-bruma/20 bg-abismo/50 p-6 backdrop-blur"
        >
          <p class="font-mono text-xs text-neon">{s.n}</p>
          <h2 class="mt-1 font-display text-2xl font-bold text-perla">{s.titulo}</h2>
          <div class="mt-3 space-y-3 leading-relaxed text-bruma">
            {s.textos.map((texto) => <p>{texto}</p>)}
          </div>
        </section>
      ))
    }
  </div>

  <section data-revelar class="mt-6 rounded-md border border-bruma/20 bg-abismo/50 p-6">
    <p class="font-mono text-xs text-neon">05</p>
    <h2 class="mt-1 font-display text-2xl font-bold text-perla">{t("case.stack")}</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        caso.stack.map((item) => (
          <li class="rounded-full border border-cian/40 bg-cian/10 px-3 py-1 font-mono text-sm text-cian">
            {item}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Cierre: invitación a contactar -->
  <section
    data-revelar
    class="mt-14 flex flex-col items-start gap-5 rounded-md border border-cian/30 bg-cian/5 p-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="font-display text-2xl font-bold text-perla">{t("case.ctaTitle")}</p>
    <a
      href={`/${lang}/#contact`}
      class="inline-flex items-center rounded-md bg-violeta px-6 py-3 font-display font-medium text-perla shadow-glow-violeta transition hover:shadow-glow-cian"
    >
      {t("case.ctaButton")}
    </a>
  </section>
</article>

<style>
  /* Las rayas de la flecha "fluyen" hacia el destino */
  @keyframes flujo {
    to {
      stroke-dashoffset: -24;
    }
  }
  .flujo {
    animation: flujo 1.2s linear infinite;
  }
</style>