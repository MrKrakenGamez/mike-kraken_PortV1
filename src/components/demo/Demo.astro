---
import PipelineDemo from "./PipelineDemo.tsx";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="demo"
  aria-labelledby="demo-titulo"
  class="mx-auto max-w-sitio px-6 py-[var(--kraken-seccion-y)]"
>
  <header class="mb-10" data-revelar>
    <p class="font-mono text-sm text-cian">
      <span class="text-neon">$</span>
      {t("demo.eyebrow")}
    </p>
    <h2 id="demo-titulo" class="mt-3 font-display text-4xl font-bold text-perla sm:text-5xl">
      {t("demo.title")}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-bruma">{t("demo.subtitle")}</p>
  </header>

  <div
    data-revelar
    class="rounded-md border border-cian/25 bg-marino/40 p-5 shadow-glow-violeta backdrop-blur sm:p-8"
  >
    <!-- client:visible = React y Motion se cargan solo cuando la demo entra en pantalla -->
    <PipelineDemo client:visible lang={lang} />
  </div>
</section>